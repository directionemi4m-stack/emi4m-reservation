# Base de données Neon (PostgreSQL) — récupérée depuis le dashboard Neon
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/emi4m?sslmode=require"

# Secret Auth.js — générer avec: npx auth secret
AUTH_SECRET=""

# SMTP Gmail (direction.emi4m@gmail.com) — utiliser un mot de passe d'application
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="direction.emi4m@gmail.com"
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="EMI4M Réservation <direction.emi4m@gmail.com>"
EMAIL_DIRECTION="direction.emi4m@gmail.com"

# Optionnel : à définir explicitement si l'auto-détection Vercel ne suffit pas
# AUTH_URL="https://reservation.emi4m.fr"

# Optionnel : synchronisation des feuilles de présence vers un Google Sheet privé.
# Sans ces 3 variables, la synchronisation est simplement ignorée (aucune erreur).
# Voir le README pour la procédure de création du compte de service Google.
# GOOGLE_SHEETS_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz..."
# GOOGLE_SERVICE_ACCOUNT_EMAIL="emi4m-sheets@mon-projet.iam.gserviceaccount.com"
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optionnel : dépôt des pièces justificatives (permis, carte d'identité) dans un
# dossier Google Drive (un sous-dossier par prof y est créé automatiquement).
# Un compte de service n'a pas de quota de stockage Drive, donc l'envoi de fichiers
# se fait au nom d'un vrai compte Google connecté une fois via OAuth (page admin
# /admin/parametres/google-drive). Étapes :
#  1. Activer l'API Google Drive sur le même projet Google Cloud.
#  2. Créer des identifiants OAuth (type "Application Web") dans Google Cloud
#     Console > API et services > Identifiants, avec comme URI de redirection
#     autorisée : https://<votre-domaine>/api/admin/drive-oauth/callback
#  3. Créer un dossier dans Google Drive, copier son identifiant depuis l'URL
#     (https://drive.google.com/drive/folders/<ID_ICI>).
#  4. Se connecter à l'appli en tant qu'admin et cliquer sur "Connecter Google
#     Drive" sur la page /admin/parametres/google-drive.
# Sans ces variables, l'envoi de document est simplement refusé avec un message clair.
# GOOGLE_DRIVE_DOCUMENTS_FOLDER_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz..."
# GOOGLE_OAUTH_CLIENT_ID="123456-abc.apps.googleusercontent.com"
# GOOGLE_OAUTH_CLIENT_SECRET="GOCSPX-..."

# Optionnel, à ne renseigner que pour le tout premier `prisma db seed` :
# crée/promeut ce compte en ADMIN pour pouvoir se connecter la première fois.
# SEED_ADMIN_EMAIL="direction.emi4m@gmail.com"
# SEED_ADMIN_NOM="EMI4M"
# SEED_ADMIN_PRENOM="Direction"

# Vérification quotidienne de la connexion Google Drive (Vercel Cron, cf. vercel.json) :
# envoie un mail à EMAIL_DIRECTION si la connexion est interrompue. Ce secret protège la
# route /api/cron/verifier-drive (Vercel l'envoie automatiquement en « Bearer »).
# CRON_SECRET="chaîne aléatoire d'au moins 16 caractères"
