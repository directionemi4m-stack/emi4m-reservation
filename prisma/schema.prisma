// Prisma schema — EMI4M Réservation de salles
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PROF
  ADMIN
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

enum StatutCreneau {
  EN_ATTENTE
  VALIDEE
  REFUSEE
  ANNULEE
}

enum TypeCours {
  INSTRUMENT
  FM
}

enum StatutPresence {
  PRESENT
  ABSENT
  EXCUSE
}

enum TypeAbsenceProf {
  RATTRAPAGE
  ARRET_MALADIE
}

enum TypeMission {
  COURS
  CONCERT
  REUNION
  AUTRE
}

enum TypeDocument {
  PERMIS_CONDUIRE
  CARTE_IDENTITE
}

// Compte prof/admin. Provisionné par la direction (pas d'auto-inscription).
// Connexion par email + mot de passe (défini via un lien envoyé par email).
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  motDePasseHash String?
  nom            String
  prenom         String
  role           Role     @default(PROF)
  actif          Boolean  @default(true)
  creeLe         DateTime @default(now())

  // Annuaire des collègues : coordonnées facultatives, remplies et partagées
  // volontairement par chacun — jamais pré-remplies avec l'email de connexion.
  telephonePartage String?
  emailPartage     String?

  tokensMotDePasse TokenMotDePasse[]

  creneauxRecurrents CreneauRecurrent[]
  demandes           Demande[]          @relation("DemandeAuteur")
  creneauxTraites    DemandeCreneau[]   @relation("CreneauTraitePar")

  classes              Classe[]             @relation("ClasseProf")
  pointages            Pointage[]           @relation("PointageProf")
  absencesProf         AbsenceProf[]        @relation("AbsenceProf")
  trajets              Trajet[]             @relation("TrajetProf")
  identite             IdentiteProf?
  documents            DocumentProf[]
  activitesAccessoires ActiviteAccessoire[]

  impersonationsEffectuees JournalImpersonation[] @relation("ImpersonationDirection")
  impersonationsSubies     JournalImpersonation[] @relation("ImpersonationCible")

  codeAlarme CodeAlarme?

  creneauxAgenda CreneauAgenda[]

  heuresHebdoContrats HeuresHebdoContrat[]

  inscriptionsHeureMusicale InscriptionHeureMusicale[]

  suivisCham           SuiviCham[]
  appreciationsCham    AppreciationCham[]
  signatureBulletin    SignatureBulletin?
  bilansChamSignes     BulletinCham[]        @relation("BilanDirection")
  abonnementsPush      AbonnementPush[]
  clesDetenues         RemiseCles[]          @relation("ClesDetenues")
  clesRemises          RemiseCles[]          @relation("ClesRemisesPar")
  clesRecues           RemiseCles[]          @relation("ClesRecuesPar")
  documentsSignes      SignatureDocument[]   @relation("DocumentsSignes")
  contrats             ContratProf[]         @relation("ContratsProf")
  idees                Idee[]                @relation("IdeesAuteur")
  plansScene           PlanScene[]           @relation("PlansSceneAuteur")
  demandesMateriel     DemandeMateriel[]     @relation("DemandesMateriel")
  propositionsMateriel PropositionMateriel[] @relation("PropositionsMateriel")
  suiviSante           SalarieSante?         @relation("SuiviSante")
}

// Lien à usage unique envoyé par email pour définir ou réinitialiser le mot de
// passe. Le token stocké est haché (sha256) ; le brut ne vit que dans l'email.
model TokenMotDePasse {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token  String   @unique
  expire DateTime
  creeLe DateTime @default(now())
}

model Commune {
  id       String    @id @default(cuid())
  nom      String    @unique
  slug     String    @unique
  salles   Salle[]
  contacts Contact[]
}

// Contact (mairie, gestionnaire de salle...) à qui adresser une demande de
// réservation par email — proposé par défaut pour les salles de sa commune.
model Contact {
  id        String  @id @default(cuid())
  nom       String
  email     String
  communeId String
  commune   Commune @relation(fields: [communeId], references: [id], onDelete: Cascade)
  actif     Boolean @default(true)
}

model Salle {
  id                String  @id @default(cuid())
  nom               String
  communeId         String
  commune           Commune @relation(fields: [communeId], references: [id])
  actif             Boolean @default(true)
  // Salle prêtée par la mairie contre une convention signée par la direction (La Coupole,
  // La Verrière, salle des fêtes de Méaudre…) : chaque réservation y a sa convention.
  conventionRequise Boolean @default(false)

  creneauxRecurrents CreneauRecurrent[]
  demandes           Demande[]
  demandeCreneaux    DemandeCreneau[]
  creneauxAgenda     CreneauAgenda[]

  @@unique([communeId, nom])
}

// Emploi du temps de base, récurrent hebdomadaire
model CreneauRecurrent {
  id          String      @id @default(cuid())
  profId      String
  prof        User        @relation(fields: [profId], references: [id])
  salleId     String
  salle       Salle       @relation(fields: [salleId], references: [id])
  jourSemaine JourSemaine
  heureDebut  DateTime    @db.Time
  heureFin    DateTime    @db.Time
  dateDebut   DateTime    @db.Date
  dateFin     DateTime?   @db.Date
  actif       Boolean     @default(true)
  creeLe      DateTime    @default(now())

  @@index([salleId, jourSemaine])
}

// "Panier" de dates soumises ensemble par un prof, pour une même salle.
model Demande {
  id      String   @id @default(cuid())
  profId  String
  prof    User     @relation("DemandeAuteur", fields: [profId], references: [id])
  salleId String
  salle   Salle    @relation(fields: [salleId], references: [id])
  creeLe  DateTime @default(now())

  creneaux DemandeCreneau[]

  @@index([profId])
}

// Une ligne = une date + un horaire précis. Le statut vit ici (pas sur Demande)
// car un même lot peut mélanger dates rejetées automatiquement et dates en attente.
model DemandeCreneau {
  id         String   @id @default(cuid())
  demandeId  String
  demande    Demande  @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  salleId    String
  salle      Salle    @relation(fields: [salleId], references: [id])
  date       DateTime @db.Date
  heureDebut DateTime @db.Time
  heureFin   DateTime @db.Time

  statut           StatutCreneau @default(EN_ATTENTE)
  rejetAutomatique Boolean       @default(false)
  creneauBloquant  String?
  motifRefus       String?
  traiteeLe        DateTime?
  traiteeParId     String?
  traiteePar       User?         @relation("CreneauTraitePar", fields: [traiteeParId], references: [id])

  convention ConventionSalle?

  @@index([salleId, date])
}

// Convention signée avec la mairie pour une réservation d'une salle « à convention » :
// dates de la demande et de la réponse, et scan archivé dans le Drive (« Conventions de
// réservation »), jamais montré aux profs. La réservation est recopiée (salle, date…) pour
// que la convention reste lisible dans le registre même si la réservation est supprimée.
model ConventionSalle {
  id                String           @id @default(cuid())
  demandeCreneauId  String?          @unique
  demandeCreneau    DemandeCreneau?  @relation(fields: [demandeCreneauId], references: [id], onDelete: SetNull)
  // Ou bien un événement de l'agenda de la saison (concert à La Verrière…), sans réservation.
  evenementSaisonId String?          @unique
  evenementSaison   EvenementSaison? @relation(fields: [evenementSaisonId], references: [id], onDelete: SetNull)
  salle             String
  commune           String
  date              DateTime         @db.Date
  horaire           String
  prof              String
  demandeMairieLe   DateTime?        @db.Date
  reponseMairieLe   DateTime?        @db.Date
  commentaire       String?
  fichierDriveId    String?
  fichierUrl        String?
  nomFichier        String?
  // Dernier rappel envoyé à la direction (scan manquant, mairie sans réponse) : un par semaine au plus.
  rappelLe          DateTime?
  creeLe            DateTime         @default(now())
  majLe             DateTime         @updatedAt

  @@index([date])
}

// Le tableur « Registre des conventions de réservation » du Drive, réécrit à chaque
// changement (lien stable).
model RegistreConventions {
  id        String @id @default("singleton")
  fichierId String
  url       String
}

// --- Présences ---

model LieuPresence {
  id                 String              @id @default(cuid())
  nom                String              @unique
  actif              Boolean             @default(true)
  classes            Classe[]
  creneauxAgenda     CreneauAgenda[]
  evenements         EvenementSaison[]
  articlesInventaire ArticleInventaire[]
  scenes             SceneConcert[]
}

model NiveauFM {
  id      String   @id @default(cuid())
  nom     String   @unique
  actif   Boolean  @default(true)
  classes Classe[]
}

// Liste fermée des matières enseignées, proposée au choix à la création d'un cours
// (remplace la saisie libre du nom). Le type détermine si niveau/lieu FM s'affichent.
model Discipline {
  id    String    @id @default(cuid())
  nom   String    @unique
  type  TypeCours @default(INSTRUMENT)
  actif Boolean   @default(true)
}

model Classe {
  id          String        @id @default(cuid())
  profId      String
  prof        User          @relation("ClasseProf", fields: [profId], references: [id])
  type        TypeCours
  nom         String
  emoji       String
  // Source de vérité pour générer et trier les séances ; jour est désormais une info
  // libre purement descriptive (horaire, salle...), plus jamais parsée pour une date.
  jourSemaine JourSemaine?
  jour        String?
  lieuId      String?
  lieu        LieuPresence? @relation(fields: [lieuId], references: [id])
  niveauFMId  String?
  niveauFM    NiveauFM?     @relation(fields: [niveauFMId], references: [id])
  dateDebut   DateTime      @db.Date
  actif       Boolean       @default(true)
  // Ensemble (chorale, orchestre…) : pas de séance chaque semaine, le prof coche ses dates
  // dans l'agenda de l'année (cf. /presences/[classeId]/agenda).
  agendaLibre Boolean       @default(false)
  creeLe      DateTime      @default(now())

  eleves       Eleve[]
  plansScene   PlanScene[]
  seances      Seance[]
  pointages    Pointage[]
  absencesProf AbsenceProf[]

  @@index([profId])
}

model Eleve {
  id       String  @id @default(cuid())
  classeId String
  classe   Classe  @relation(fields: [classeId], references: [id], onDelete: Cascade)
  nom      String
  actif    Boolean @default(true)

  marques PresenceMarque[]
}

model Seance {
  id            String    @id @default(cuid())
  classeId      String
  classe        Classe    @relation(fields: [classeId], references: [id], onDelete: Cascade)
  date          DateTime  @db.Date
  // Ancien rappel « appel à faire » envoyé au prof (rappels arrêtés le 9 nov. 2026, colonne gardée pour l'historique).
  rappelAppelLe DateTime?
  // Exception à l'horaire et au lieu habituels du cours (ex. répétition générale le samedi).
  horaire       String?
  lieu          String?

  pointage    Pointage?
  absenceProf AbsenceProf?

  @@index([classeId, date])
}

// Une séance où le prof (pas un élève) était absent — rattrapage à prévoir,
// ou arrêt maladie à suivre. Exclusif avec Pointage pour la même séance.
model AbsenceProf {
  id             String          @id @default(cuid())
  seanceId       String          @unique
  seance         Seance          @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  classeId       String
  classe         Classe          @relation(fields: [classeId], references: [id], onDelete: Cascade)
  profId         String
  prof           User            @relation("AbsenceProf", fields: [profId], references: [id])
  type           TypeAbsenceProf
  dateRattrapage DateTime?       @db.Date
  commentaire    String?
  creeLe         DateTime        @default(now())

  @@index([classeId])
}

// Une feuille de présence pour une séance donnée (au plus une par séance).
model Pointage {
  id       String   @id @default(cuid())
  seanceId String   @unique
  seance   Seance   @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  classeId String
  classe   Classe   @relation(fields: [classeId], references: [id], onDelete: Cascade)
  profId   String
  prof     User     @relation("PointageProf", fields: [profId], references: [id])
  creeLe   DateTime @default(now())
  majLe    DateTime @updatedAt

  marques PresenceMarque[]

  @@index([classeId])
}

model PresenceMarque {
  id         String         @id @default(cuid())
  pointageId String
  pointage   Pointage       @relation(fields: [pointageId], references: [id], onDelete: Cascade)
  eleveId    String
  eleve      Eleve          @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  statut     StatutPresence @default(PRESENT)

  @@unique([pointageId, eleveId])
}

// --- Frais de déplacement ---

// Trajet type de référence (ex. « Villard/Autrans »), géré par l'admin — km et
// prix fixes, saisis une fois (barème kilométrique), pas recalculés à la volée.
model TypeTrajet {
  id      String   @id @default(cuid())
  nom     String   @unique
  km      Float
  prix    Float
  actif   Boolean  @default(true)
  trajets Trajet[]
}

// Un trajet loggé par un prof. km/prix/nom sont une copie de TypeTrajet au
// moment de la saisie : un trajet déjà enregistré ne doit pas bouger si le
// barème change plus tard.
model Trajet {
  id               String      @id @default(cuid())
  profId           String
  prof             User        @relation("TrajetProf", fields: [profId], references: [id])
  date             DateTime    @db.Date
  typeMission      TypeMission
  precisionMission String?
  typeTrajetId     String
  typeTrajet       TypeTrajet  @relation(fields: [typeTrajetId], references: [id])
  trajetNom        String
  km               Float
  prix             Float
  // Suppression « douce », comme pour ActiviteAccessoire : la ligne du classeur
  // comptabilité reste en place (vidée) plutôt que de disparaître, pour ne jamais
  // décaler un commentaire du comptable posé dessus.
  supprimeLe       DateTime?
  creeLe           DateTime    @default(now())

  @@index([profId, date])
}

// Fiche identité/véhicule d'un prof, saisie une fois — sert de justificatif
// pour les remboursements de frais kilométriques (permis, assurance, véhicule).
model IdentiteProf {
  id                      String   @id @default(cuid())
  profId                  String   @unique
  prof                    User     @relation(fields: [profId], references: [id], onDelete: Cascade)
  adresseDomicile         String?
  numeroPermis            String?
  numeroCarteGrise        String?
  numeroAssuranceAuto     String?
  immatriculationVehicule String?
  marqueModeleVehicule    String?
  puissanceFiscale        String?
  majLe                   DateTime @updatedAt
}

// Copie d'une pièce justificative (permis, carte d'identité) — le fichier lui-même
// vit uniquement dans Google Drive (dossier personnel du prof) ; ici on ne garde
// que la référence. Un envoi remplace le précédent (un seul document par type et par prof).
model DocumentProf {
  id          String       @id @default(cuid())
  profId      String
  prof        User         @relation(fields: [profId], references: [id], onDelete: Cascade)
  type        TypeDocument
  nomFichier  String
  driveFileId String
  driveUrl    String
  creeLe      DateTime     @default(now())
  majLe       DateTime     @updatedAt

  @@unique([profId, type])
}

// Jeton OAuth d'un vrai compte Google (pas le compte de service — celui-ci n'a pas
// de quota de stockage Drive et ne peut donc pas y déposer de fichiers). Ligne unique.
model ConfigGoogle {
  id              String    @id @default("singleton")
  refreshToken    String
  compteEmail     String?
  // Dernier mail d'alerte « connexion interrompue » envoyé à la direction (évite de
  // renvoyer le même mail à chaque vérification). Remis à null dès que la connexion revient.
  alerteEnvoyeeLe DateTime?
  majLe           DateTime  @updatedAt
}

// --- CHAM (classes à horaires aménagés musique) ---

enum AutorisationIntercours {
  A_RENSEIGNER // pas encore renseigné : par prudence, l'enfant n'est PAS présumé autorisé à sortir
  AUTORISE
  NON_AUTORISE
}

enum AutorisationSortie {
  A_RENSEIGNER // pas encore renseigné : par prudence, l'enfant n'est PAS présumé autorisé à partir seul
  SEUL // les parents autorisent l'enfant à quitter seul l'établissement
  ACCOMPAGNE // l'enfant doit être récupéré par un adulte
}

// Élève CHAM : liste consultable par tous les enseignants, modifiable uniquement par la direction.
model EleveCham {
  id                      String                 @id @default(cuid())
  // « Identifiant » du fichier d'origine (export de contacts) — permet de réimporter sans doublons.
  identifiantExterne      String?                @unique
  prenom                  String
  nom                     String
  age                     Int?
  // Année scolaire où l'élève était (ou sera) en 6e : 2026 pour 2026-2027. La classe
  // (6e, 5e, 4e, 3e) s'en déduit pour chaque année, sans ressaisie à la rentrée ; un
  // redoublement se corrige en changeant la classe sur la fiche.
  anneeSixieme            Int?
  // Division au collège (« 5B ») : elle ne vaut que pour son année scolaire. Les années
  // suivantes, on affiche seulement le niveau, jusqu'à la nouvelle répartition.
  division                String?
  anneeDivision           Int?
  telephone               String?
  email                   String?
  ville                   String?
  // Sortie entre deux cours, et sortie de fin de journée à 16h30 : deux autorisations
  // distinctes, signées par les parents sur une même fiche (cf. document* ci-dessous).
  autorisationIntercours  AutorisationIntercours @default(A_RENSEIGNER)
  autorisationSortie16h30 AutorisationSortie     @default(A_RENSEIGNER)
  // Précisions libres (ex. « peut partir avec sa sœur », « récupéré par sa grand-mère »).
  precisionsSortie        String?
  // Fiche d'autorisation signée, scannée par la direction et stockée dans le dossier
  // Drive « Suivi CHAM » (jamais montrée aux profs, qui ne voient que les autorisations).
  documentDriveId         String?
  documentUrl             String?
  documentNom             String?
  documentMajLe           DateTime?
  creeLe                  DateTime               @default(now())
  majLe                   DateTime               @updatedAt

  suivis        SuiviCham[]
  appreciations AppreciationCham[]
  bulletins     BulletinCham[]

  @@index([nom, prenom])
}

// --- Bulletins CHAM ---

// Les rubriques du bulletin, dans l'ordre du modèle papier.
enum MatiereCham {
  FORMATION_MUSICALE
  INSTRUMENT
  HISTOIRE_MUSIQUE
  PRATIQUES_COLLECTIVES
}

// Un prof déclare lui-même les élèves CHAM qu'il suit, et dans quelle rubrique. La liste
// est gardée d'un trimestre à l'autre ; c'est elle qui dit quels bulletins il lui reste à
// remplir (et donc à qui envoyer les relances).
model SuiviCham {
  id        String      @id @default(cuid())
  eleveId   String
  eleve     EleveCham   @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  profId    String
  prof      User        @relation(fields: [profId], references: [id], onDelete: Cascade)
  matiere   MatiereCham
  precision String? // ex. « Piano », « Orchestre », « Chorale »
  creeLe    DateTime    @default(now())

  @@unique([eleveId, profId, matiere])
  @@index([profId])
}

// La partie d'un prof dans le bulletin d'un élève, pour un trimestre : appréciation et
// signature manuscrite (PNG dessiné à l'écran). Modifier le texte oblige à re-signer.
model AppreciationCham {
  id            String      @id @default(cuid())
  eleveId       String
  eleve         EleveCham   @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  profId        String
  prof          User        @relation(fields: [profId], references: [id], onDelete: Cascade)
  matiere       MatiereCham
  precision     String?
  anneeDebut    Int // 2026 pour 2026-2027
  trimestre     Int // 1, 2 ou 3
  texte         String
  signature     Bytes
  signeLe       DateTime
  // Compte partagé de la direction : le nom de la personne qui a signé, gardé tel quel
  // même si la direction change ensuite.
  signataireNom String?

  @@unique([eleveId, profId, matiere, anneeDebut, trimestre])
  @@index([anneeDebut, trimestre])
}

// Dernière signature dessinée par un prof : proposée d'office pour les bulletins suivants.
// Table à part pour ne pas charger l'image à chaque lecture d'un utilisateur.
model SignatureBulletin {
  userId String   @id
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  image  Bytes
  majLe  DateTime @updatedAt
}

// Le bulletin d'un élève pour un trimestre : bilan et signature de la direction, et le
// PDF compilé (toutes les parties et toutes les signatures) déposé dans le Drive.
model BulletinCham {
  id                 String    @id @default(cuid())
  eleveId            String
  eleve              EleveCham @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  anneeDebut         Int
  trimestre          Int
  bilan              String?
  signatureDirection Bytes?
  directionId        String?
  direction          User?     @relation("BilanDirection", fields: [directionId], references: [id])
  signeDirectionLe   DateTime?
  directionNom       String? // « Prénom Nom - direction », figé à la signature
  documentDriveId    String?
  documentUrl        String?
  documentMajLe      DateTime?
  // Dernier envoi du bulletin à la famille (mail avec le PDF en pièce jointe).
  envoyeLe           DateTime?
  envoyeA            String?

  @@unique([eleveId, anneeDebut, trimestre])
}

// Abonnement d'un appareil aux notifications (Web Push) : un prof peut en avoir plusieurs
// (téléphone, ordinateur). Supprimé dès que le navigateur le déclare expiré.
model AbonnementPush {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String   @unique
  p256dh   String
  auth     String
  creeLe   DateTime @default(now())

  @@index([userId])
}

// Trace des envois de rappels de bulletins, pour ne jamais envoyer deux fois le même
// (le cron peut être relancé, ou rattraper un jour manqué).
model RappelBulletinCham {
  id         String   @id @default(cuid())
  anneeDebut Int
  trimestre  Int
  type       String // « OUVERTURE » (le 15) ou « RELANCE » (4 jours après)
  envoyeLe   DateTime @default(now())

  @@unique([anneeDebut, trimestre, type])
}

// --- Activité accessoire ---

// Type d'événement, géré par l'admin (Heure Musicale, Concert, Réunion...) — même
// principe que TypeTrajet : liste fermée proposée au choix, copiée au moment de la
// saisie pour qu'une entrée déjà enregistrée ne bouge pas si la liste change ensuite.
model TypeEvenementAccessoire {
  id           String               @id @default(cuid())
  nom          String               @unique
  actif        Boolean              @default(true)
  // Ex. « Remplacement » : ces heures sont toujours payées au salarié, sans entamer
  // son forfait annuel d'activité accessoire (cf. lib/forfaitAccessoire.ts).
  toujoursPaye Boolean              @default(false)
  activites    ActiviteAccessoire[]
}

// Une entrée d'activité accessoire saisie par un prof (concert, réunion, remplacement...).
// Synchronisée vers le classeur comptabilité en conservant la position de chaque ligne
// (jamais réordonnée, jamais retirée) : le comptable peut y laisser des commentaires
// dans Google Sheets sans craindre qu'ils se retrouvent sur la mauvaise ligne.
model ActiviteAccessoire {
  id                      String                  @id @default(cuid())
  profId                  String
  prof                    User                    @relation(fields: [profId], references: [id])
  date                    DateTime                @db.Date
  typeEvenementId         String
  typeEvenement           TypeEvenementAccessoire @relation(fields: [typeEvenementId], references: [id])
  typeEvenementNom        String
  duree                   String // ex. "1h30" — liste fixe, cf. lib/activiteAccessoire.ts
  // Coché par la direction seulement : heures payées hors forfait (financement
  // exceptionnel), quel que soit le type d'événement.
  financementExceptionnel Boolean                 @default(false)
  // Suppression « douce » : la ligne reste dans le classeur (vidée, marquée « Supprimée »)
  // plutôt que d'être retirée, pour ne jamais décaler les lignes suivantes ni les
  // commentaires du comptable qui y sont accrochés.
  supprimeLe              DateTime?
  creeLe                  DateTime                @default(now())

  @@index([profId, date])
}

// --- Vacances scolaires ---

// Périodes [début, fin[ (reprise exclue) administrables, à la place d'une liste codée
// en dur dans le code — remplie une fois par la direction, chaque année scolaire.
model PeriodeVacances {
  id    String   @id @default(cuid())
  nom   String
  debut DateTime @db.Date
  fin   DateTime @db.Date
}

// --- Journal « Se connecter en tant que » ---

// Trace chaque impersonation (qui, pour qui, quand), pour la traçabilité d'une
// fonctionnalité qui donne un accès total à un autre compte.
model JournalImpersonation {
  id          String    @id @default(cuid())
  directionId String
  direction   User      @relation("ImpersonationDirection", fields: [directionId], references: [id])
  cibleId     String
  cible       User      @relation("ImpersonationCible", fields: [cibleId], references: [id])
  demarreLe   DateTime  @default(now())
  termineLe   DateTime?

  @@index([directionId, termineLe])
}

// --- Sécurité des bâtiments ---

// Consignes de sécurité affichées dans un bâtiment (incendie, évacuation, accident),
// modifiables par la direction. Le contenu suit la structure de l'affiche officielle
// (cf. lib/securite.ts#ConsignesContenu) ; les gestes réflexes, eux, restent fixes.
model ConsignesSecurite {
  id      String   @id @default(cuid())
  site    String   @unique // ex. "villard"
  contenu Json
  majLe   DateTime @updatedAt
}

// Code d'alarme personnel du bâtiment de Lans-en-Vercors (un par salarié, donné par le
// responsable du bâtiment et saisi par la direction). Jamais stocké en clair : chiffré
// en AES-256-GCM (clé CLE_CHIFFREMENT_CODES), illisible même avec un accès à la base.
model CodeAlarme {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeChiffre String
  majLe       DateTime @updatedAt
}

// --- Emploi du temps hebdomadaire des profs ---

enum TypeCreneauAgenda {
  INDIVIDUEL
  COLLECTIF
}

// Un cours de la semaine type d'un prof, saisi par lui-même : sert à produire son emploi
// du temps détaillé et son volume horaire hebdomadaire (contrats) dans le classeur
// « Emplois du temps » de la direction. Indépendant des séances de Présences.
model CreneauAgenda {
  id                String            @id @default(cuid())
  profId            String
  prof              User              @relation(fields: [profId], references: [id])
  jourSemaine       JourSemaine
  heureDebutMinutes Int // minutes depuis minuit (14h15 = 855), pour trier et détecter les chevauchements
  dureeMinutes      Int
  type              TypeCreneauAgenda
  nom               String // élève (individuel) ou groupe (collectif), saisie libre
  // Compté pour moitié dans le volume horaire hebdomadaire.
  uneSemaineSurDeux Boolean           @default(false)
  lieuId            String?
  lieu              LieuPresence?     @relation(fields: [lieuId], references: [id])
  // Facultative : certaines communes (Corrençon, Engins…) n'ont pas de salle répertoriée.
  salleId           String?
  salle             Salle?            @relation(fields: [salleId], references: [id])
  creeLe            DateTime          @default(now())

  @@index([profId, jourSemaine])
}

// --- Forfait d'activité accessoire ---

// Volume horaire hebdomadaire du contrat d'un salarié pour une année scolaire, saisi par
// la direction seule (jamais montré aux profs). Il fixe le forfait annuel d'activité
// accessoire dû à l'école : heures hebdo × 6 ; au-delà, les heures sont payées.
model HeuresHebdoContrat {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  anneeScolaire String // ex. "2026-2027"
  minutesHebdo  Int
  majLe         DateTime @updatedAt

  @@unique([userId, anneeScolaire])
}

// --- Agenda de la saison et heures musicales ---

enum TypeEvenementSaison {
  HEURE_MUSICALE
  CONCERT
  AUDITION
  EXAMEN
  REUNION
  AUTRE
}

// Événement de l'agenda de la saison, saisi par la direction et visible de tous. Une
// heure musicale reçoit les inscriptions des élèves ; son lieu, sa date et son heure
// sont repris d'ici partout (page d'inscription, programme, classeur).
model EvenementSaison {
  id                String              @id @default(cuid())
  type              TypeEvenementSaison
  titre             String
  date              DateTime            @db.Date
  heureDebutMinutes Int? // minutes depuis minuit, facultative
  lieuId            String? // commune
  lieu              LieuPresence?       @relation(fields: [lieuId], references: [id])
  lieuPrecis        String? // ex. « Salle Berlioz », « Église de Méaudre »
  description       String?
  dureeMaxMinutes   Int? // heures musicales : durée prévue, pour alerter si les inscriptions la dépassent
  // Onglet du programme dans le classeur « Saison » (heures musicales) : retrouvé par son
  // identifiant, pour pouvoir le renommer si la date ou le titre changent.
  ongletSheetId     Int?
  creeLe            DateTime            @default(now())

  inscriptions InscriptionHeureMusicale[]
  convention   ConventionSalle?
  // Plans de scène : la scène du concert (dimensions reprises par chaque nouveau passage).
  sceneId      String?
  scene        SceneConcert?              @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  plans        PlanScene[]

  @@index([date])
}

// Un élève inscrit par son prof à une heure musicale.
model InscriptionHeureMusicale {
  id               String          @id @default(cuid())
  evenementId      String
  evenement        EvenementSaison @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  profId           String
  prof             User            @relation(fields: [profId], references: [id])
  eleveNom         String
  instrument       String
  programme        String // résumé des œuvres (« Menuet en sol (J.S. Bach) ; … »), tiré des morceaux
  minutageSecondes Int // total des durées des morceaux
  materiel         String?
  commentaire      String?
  ordre            Int // ordre de passage, réglable par la direction
  creeLe           DateTime        @default(now())

  morceaux MorceauProgramme[]
  plans    PlanScene[]

  @@index([evenementId, ordre])
}

// Une œuvre jouée lors d'un passage (heure musicale, concert, audition…) : le détail
// demandé par la SACEM pour le relevé des programmes.
model MorceauProgramme {
  id            String                   @id @default(cuid())
  inscriptionId String
  inscription   InscriptionHeureMusicale @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  ordre         Int
  titre         String
  compositeur   String
  arrangeur     String?
  dureeSecondes Int

  @@index([inscriptionId, ordre])
}

// Coordonnées de l'école, reprises sur les documents officiels (relevé SACEM…).
// Une seule ligne (id « singleton »), modifiable par la direction.
model CoordonneesEcole {
  id                 String   @id @default("singleton")
  nom                String
  sigle              String
  adresse            String // plusieurs lignes possibles
  telephone          String?
  email              String?
  siteWeb            String?
  siret              String?
  numeroSacem        String? // numéro de client SACEM, s'il y en a un
  representant       String? // « Prénom Nom, président(e) »
  // Présidence : signe les contrats et avenants des profs, à distance (lien par mail).
  presidenceNom      String?
  presidenceQualite  String? // « Présidente », « Président », « Co-président »…
  presidenceEmail    String?
  // Direction : nom affiché sur les bulletins CHAM (le compte de connexion est partagé).
  directionNom       String?
  directionFonction  String?
  // Devis et factures émis.
  mentionTva         String? // « TVA non applicable… »
  conditionsPaiement String? // reprises par défaut sur chaque devis et facture
  mentionsFacture    String? // pénalités de retard, indemnité de recouvrement…
  iban               String?
  bic                String?
  majLe              DateTime @updatedAt
}

// --- Locations d'instruments ---

enum ModePaiementLocation {
  CHEQUE
  VIREMENT
}

// Caution déposée par la famille pour l'instrument.
enum CautionLocation {
  RECUE
  MANQUANTE
  RENDUE
}

// Une location d'instrument pour une saison (2026 = 2026-2027). Une ligne par élève et par
// saison : d'une année sur l'autre, la location est reconduite en nouvelle ligne, ce qui
// garde l'historique complet. Réservé à la direction (données des familles).
model LocationInstrument {
  id              String                @id @default(cuid())
  anneeDebut      Int
  instrument      String
  prenom          String
  nom             String
  anneeLocation   Int // 1 = 1re année, 2 = 2e année, 3 = 3e année…
  nbMois          Int? // 9 ou 12
  paye            Boolean               @default(false)
  modePaiement    ModePaiementLocation?
  caution         CautionLocation? // vide = pas encore renseignée
  commentaire     String?
  // Sous-dossier Drive de cette location (« Locations instruments / 2026-2027 / NOM Prénom — Instrument »).
  dossierDriveId  String?
  dossierDriveUrl String?
  creeLe          DateTime              @default(now())
  majLe           DateTime              @updatedAt

  documents DocumentLocation[]

  @@index([anneeDebut])
  @@index([nom, prenom])
}

// Document rendu par la famille (contrat, attestation…), envoyé en PDF ou pris en photo,
// archivé dans le dossier Drive de la location.
model DocumentLocation {
  id          String             @id @default(cuid())
  locationId  String
  location    LocationInstrument @relation(fields: [locationId], references: [id], onDelete: Cascade)
  nomFichier  String
  driveFileId String
  url         String
  ajouteLe    DateTime           @default(now())

  @@index([locationId])
}

// Demande de location en attente d'un instrument disponible.
model DemandeLocation {
  id          String   @id @default(cuid())
  anneeDebut  Int
  instrument  String
  prenom      String
  nom         String
  commentaire String?
  creeLe      DateTime @default(now())

  @@index([anneeDebut])
}

// --- Inventaire du matériel ---

enum CategorieInventaire {
  MUSIQUE
  BUREAU
  LOGICIEL
  AUTRE
}

enum EtatMateriel {
  BON
  A_REVISER
  HORS_SERVICE
  SORTI // vendu, donné ou mis au rebut : gardé pour l'historique
}

// Un bien de l'école (instrument, sono, ordinateur…), immobilisé ou non. Les photos
// lèvent le doute quand il n'y a qu'une référence ou pas de numéro de série.
model ArticleInventaire {
  id              String              @id @default(cuid())
  numeroImmo      Int?                @unique // n° de l'inventaire des immobilisations du comptable
  designation     String
  categorie       CategorieInventaire @default(MUSIQUE)
  marqueModele    String?
  numeroSerie     String?
  dateAcquisition DateTime?           @db.Date
  valeurCentimes  Int?
  lieuId          String?
  lieu            LieuPresence?       @relation(fields: [lieuId], references: [id])
  localisation    String? // salle, placard, prof qui l'a chez lui…
  etat            EtatMateriel        @default(BON)
  remarques       String?
  verifieLe       DateTime? // dernière fois qu'on l'a vu lors d'un inventaire
  dossierDriveId  String?
  dossierDriveUrl String?
  creeLe          DateTime            @default(now())
  majLe           DateTime            @updatedAt

  photos   PhotoInventaire[]
  factures Facture[]

  @@index([categorie])
}

// Photo d'un bien : l'original est rangé dans le Drive, une miniature est gardée ici pour
// l'afficher dans l'appli sans passer par Google.
model PhotoInventaire {
  id          String            @id @default(cuid())
  articleId   String
  article     ArticleInventaire @relation(fields: [articleId], references: [id], onDelete: Cascade)
  driveFileId String
  url         String
  miniature   Bytes
  ajouteLe    DateTime          @default(now())

  @@index([articleId])
}

// --- Achats : factures archivées ---

// Facture d'achat, archivée en PDF dans le Drive (« Factures / 2026 / 2026-10-28_Thomann.pdf »).
// Elle peut être rattachée à un ou plusieurs biens de l'inventaire, pour la traçabilité.
model Facture {
  id               String              @id @default(cuid())
  date             DateTime            @db.Date
  fournisseur      String
  montantCentimes  Int?
  objet            String?
  nomFichier       String
  driveFileId      String
  url              String
  ajouteLe         DateTime            @default(now())
  payeeLe          DateTime?           @db.Date // vide : à payer (rappel 7 jours après l'ajout)
  rappelPaiementLe DateTime? // dernier rappel envoyé, pour n'en faire qu'un par semaine
  articles         ArticleInventaire[]
  devisRecu        DevisRecu?
  attestationAchat AttestationAchat?
  factureSante     FactureSante?

  @@index([date])
  @@index([fournisseur])
}

// --- Clés et badges ---

// Une remise de clés/badges à un salarié, signée par lui au doigt sur le téléphone de la
// direction (ou reprise du registre papier). La restitution se signe sur la même ligne,
// comme sur le registre papier.
model RemiseCles {
  id                            String    @id @default(cuid())
  profId                        String
  prof                          User      @relation("ClesDetenues", fields: [profId], references: [id], onDelete: Cascade)
  clesAutransMeaudre            Int       @default(0)
  badgeLans                     Int       @default(0)
  clesVillard                   Int       @default(0)
  remiseLe                      DateTime  @db.Date
  signatureRemise               Bytes? // vide si signée sur le registre papier
  signatureDirectionRemise      Bytes? // contre-signature de la direction
  remiseParId                   String?
  remisePar                     User?     @relation("ClesRemisesPar", fields: [remiseParId], references: [id])
  restitueLe                    DateTime? @db.Date
  signatureRestitution          Bytes?
  signatureDirectionRestitution Bytes?
  restitutionPapier             Boolean   @default(false)
  restitueParId                 String?
  restituePar                   User?     @relation("ClesRecuesPar", fields: [restitueParId], references: [id])
  commentaire                   String?
  creeLe                        DateTime  @default(now())

  @@index([profId])
  @@index([remiseLe])
}

// Le registre PDF d'une saison, régénéré à chaque signature et rangé dans le Drive.
model RegistreCles {
  anneeDebut  Int      @id
  driveFileId String
  url         String
  majLe       DateTime @updatedAt
}

// --- Documents à lire et signer ---

// Un document que chaque salarié doit lire et signer (consignes de sécurité, procédure
// d'évacuation…). Une nouvelle version remplace le PDF et demande à chacun de re-signer.
model DocumentASigner {
  id             String              @id @default(cuid())
  titre          String
  attestation    String // phrase signée : « Je certifie avoir lu… »
  version        Int                 @default(1)
  pdf            Bytes
  nomFichier     String
  publieLe       DateTime            @default(now()) // date de la version en cours
  relanceLe      DateTime? // relance des retardataires, envoyée une fois par version
  retireLe       DateTime? // plus à signer (gardé pour l'historique)
  registreFileId String? // registre PDF de la version en cours, dans le Drive
  registreUrl    String?
  creeLe         DateTime            @default(now())
  signatures     SignatureDocument[]
}

// La signature d'une version d'un document par un salarié, avec sa copie signée (document
// + page d'attestation) rangée dans le Drive de la direction.
model SignatureDocument {
  id          String          @id @default(cuid())
  documentId  String
  document    DocumentASigner @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     Int
  userId      String
  user        User            @relation("DocumentsSignes", fields: [userId], references: [id], onDelete: Cascade)
  signeLe     DateTime        @default(now())
  image       Bytes
  driveFileId String?
  url         String?

  @@unique([documentId, version, userId])
  @@index([userId])
}

// Message type des demandes de salle aux mairies, modifiable par la direction (repli sur
// le texte d'origine tant qu'il n'a pas été enregistré). Variables : {salle}, {commune},
// {date}, {debut}, {fin}.
model ModeleMailMairie {
  id    String   @id @default("singleton")
  sujet String
  corps String
  majLe DateTime @updatedAt
}

// Échecs de connexion récents, par adresse : au-delà d'un seuil, les essais sont refusés
// un moment (protection contre la recherche du mot de passe par essais successifs).
model EchecConnexion {
  id    String   @id @default(cuid())
  email String
  le    DateTime @default(now())

  @@index([email, le])
}

// --- Annuaire des élèves ---

// Un élève de l'année, tiré du fichier Excel des inscriptions que la direction importe
// chaque année (chaque import remplace l'annuaire entier). Visible par tous les comptes
// de l'école. Plusieurs instruments, mails ou téléphones possibles (ex. ceux des parents).
model EleveAnnuaire {
  id          String   @id @default(cuid())
  nom         String
  prenom      String
  instruments String[]
  emails      String[]
  telephones  String[]
  commune     String?

  @@index([nom, prenom])
}

// Trace de chaque import : la date affichée aux profs, et la correspondance colonnes →
// informations, reproposée telle quelle au fichier de l'année suivante.
model ImportAnnuaireEleves {
  id             String   @id @default(cuid())
  nomFichier     String
  nbEleves       Int
  importePar     String
  correspondance Json
  importeLe      DateTime @default(now())
}

// Dernière sauvegarde hebdomadaire de la base dans le Drive (cf. lib/sauvegarde.ts).
model EtatSauvegarde {
  id         String    @id @default("singleton")
  tenteeLe   DateTime
  reussieLe  DateTime?
  fichierUrl String?
  taille     Int?
  nbLignes   Int?
  erreur     String?
}

// Mail important qui n'a pas pu partir (décision envoyée à un prof…) : affiché à la
// direction en haut de « À traiter » jusqu'à ce qu'elle le marque comme vu.
model EchecMail {
  id           String    @id @default(cuid())
  le           DateTime  @default(now())
  destinataire String
  objet        String
  detail       String
  vuLe         DateTime?

  @@index([vuLe])
}

// Étapes de la rentrée cochées à la main par la direction (cf. /admin/rentree) ; les autres
// étapes sont vérifiées automatiquement d'après les données de l'appli.
model EtapeRentree {
  saison  Int // année de début : 2026 pour 2026-2027
  cle     String
  faiteLe DateTime @default(now())

  @@id([saison, cle])
}

// Jour férié (11 novembre, lundi de Pâques…) déclaré d'un clic depuis une séance : aucune
// séance de ce jour-là n'est réclamée comme « appel à faire », pour tous les cours.
model JourFerie {
  date       DateTime @id @db.Date
  declarePar String // « Prénom Nom » de qui l'a déclaré
  declareLe  DateTime @default(now())
}

// --- Devis et factures ---

enum StatutDevisRecu {
  EN_ATTENTE
  SIGNE
  ABANDONNE
}

// Devis reçu d'un fournisseur : archivé dans le Drive (« Devis reçus / 2026 / En attente »),
// puis signé ou abandonné ; relié à la facture d'achat quand elle arrive.
model DevisRecu {
  id               String          @id @default(cuid())
  date             DateTime        @db.Date
  fournisseur      String
  objet            String?
  montantCentimes  Int?
  valableJusquAu   DateTime?       @db.Date
  statut           StatutDevisRecu @default(EN_ATTENTE)
  motifAbandon     String?
  decideLe         DateTime?
  nomFichier       String
  driveFileId      String
  url              String
  signeDriveFileId String?
  signeUrl         String?
  factureId        String?         @unique
  facture          Facture?        @relation(fields: [factureId], references: [id], onDelete: SetNull)
  ajouteLe         DateTime        @default(now())

  @@index([statut])
}

enum StatutDevisEmis {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
}

// Devis fait par l'EMI4M (intervention, concert…) : numéroté D-2026-001, PDF à l'en-tête
// de l'école, envoyé, puis accepté ou refusé ; une fois accepté, il donne la facture.
model DevisEmis {
  id               String          @id @default(cuid())
  numero           String          @unique
  annee            Int
  dateDevis        DateTime        @db.Date
  valableJusquAu   DateTime        @db.Date
  clientNom        String
  clientAdresse    String?
  clientEmail      String?
  objet            String
  datePrestation   String? // texte libre : « mardi 12 janvier 2027 », « de janvier à mars »
  conditions       String?
  notes            String? // internes, jamais imprimées
  statut           StatutDevisEmis @default(BROUILLON)
  envoyeLe         DateTime?
  decideLe         DateTime?
  motifRefus       String?
  pdfDriveFileId   String?
  pdfUrl           String?
  signeDriveFileId String?
  signeUrl         String?
  creeLe           DateTime        @default(now())
  majLe            DateTime        @updatedAt

  lignes   LigneDocument[]
  factures FactureEmise[]

  @@index([annee])
}

// Facture émise par l'EMI4M, numérotée sans trou (F-2026-001) : non modifiable une fois
// émise ; seule la dernière de l'année peut être supprimée.
model FactureEmise {
  id             String     @id @default(cuid())
  numero         String     @unique
  annee          Int
  devisId        String?
  devis          DevisEmis? @relation(fields: [devisId], references: [id], onDelete: SetNull)
  dateFacture    DateTime   @db.Date
  echeance       DateTime   @db.Date
  clientNom      String
  clientAdresse  String?
  clientEmail    String?
  objet          String
  datePrestation String?
  conditions     String?
  payeeLe        DateTime?  @db.Date
  envoyeeLe      DateTime?
  pdfDriveFileId String?
  pdfUrl         String?
  creeLe         DateTime   @default(now())

  lignes LigneDocument[]

  @@index([annee])
}

// Une ligne d'un devis ou d'une facture.
model LigneDocument {
  id                   String        @id @default(cuid())
  devisId              String?
  devis                DevisEmis?    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  factureId            String?
  facture              FactureEmise? @relation(fields: [factureId], references: [id], onDelete: Cascade)
  ordre                Int
  designation          String
  quantite             Float
  unite                String?
  prixUnitaireCentimes Int

  @@index([devisId])
  @@index([factureId])
}

// Prestation type proposée dans les devis (« Intervention en milieu scolaire », « Concert »…),
// modifiable par la direction.
model RubriquePrestation {
  id                   String  @id @default(cuid())
  libelle              String
  description          String?
  unite                String? // « heure », « séance », « forfait »…
  prixUnitaireCentimes Int?
  ordre                Int     @default(0)
  actif                Boolean @default(true)
}

// --- Achats de matériel d'occasion à un particulier ---

enum ModePaiementAchat {
  VIREMENT
  CHEQUE
  ESPECES
}

enum DestinationAchat {
  ECOLE
  LOCATION
}

// Attestation de vente d'un particulier à l'EMI4M (matériel d'occasion), numérotée
// ACH-2026-001 : éditée à signer, puis archivée signée dans le Drive et ajoutée aux achats.
model AttestationAchat {
  id                String             @id @default(cuid())
  numero            String             @unique
  annee             Int
  date              DateTime           @db.Date
  vendeurNom        String
  vendeurAdresse    String?
  vendeurTelephone  String?
  vendeurEmail      String?
  vendeurPiece      String? // type et n° de la pièce d'identité
  representant      String?
  qualite           String?
  faitA             String?
  modePaiement      ModePaiementAchat?
  referencePaiement String? // référence du virement ou n° du chèque
  banque            String?
  datePaiement      DateTime?          @db.Date
  dateRemise        DateTime?          @db.Date
  // Fiche interne de suivi.
  demandePar        String?
  motif             String?
  destination       DestinationAchat?
  affectation       String?
  pdfDriveFileId    String?
  pdfUrl            String?
  signeLe           DateTime?
  signeDriveFileId  String?
  signeUrl          String?
  pieceDriveFileId  String? // copie de la pièce d'identité du vendeur (direction seulement)
  // Signature sur place, au doigt sur le téléphone de la direction.
  signatureVendeur  Bytes?
  signatureAcheteur Bytes?
  signeSurPlaceLe   DateTime?
  // Exemplaire du vendeur envoyé par mail (PDF signé en pièce jointe).
  copieEnvoyeeLe    DateTime?
  copieEnvoyeeA     String?
  factureId         String?            @unique
  facture           Facture?           @relation(fields: [factureId], references: [id], onDelete: SetNull)
  creeLe            DateTime           @default(now())

  lignes LigneAttestationAchat[]

  @@index([annee])
}

model LigneAttestationAchat {
  id            String           @id @default(cuid())
  attestationId String
  attestation   AttestationAchat @relation(fields: [attestationId], references: [id], onDelete: Cascade)
  ordre         Int
  designation   String
  marqueModele  String?
  numeroSerie   String?
  etat          String?
  prixCentimes  Int
}

// --- Contrats et avenants des profs ---

enum TypeContratProf {
  CONTRAT
  AVENANT
}

// Contrat ou avenant d'un prof pour une année scolaire. Le PDF déposé par la direction est
// d'abord signé par la présidence (à distance), puis par le prof dans l'appli ; chacun
// paraphe chaque page. La copie signée est générée à partir de l'original et des images.
// « papier » : document déjà signé à la main, simplement archivé.
model ContratProf {
  id                  String          @id @default(cuid())
  profId              String
  prof                User            @relation("ContratsProf", fields: [profId], references: [id], onDelete: Cascade)
  anneeDebut          Int // 2026 pour 2026-2027
  type                TypeContratProf
  titre               String
  pdf                 Bytes
  nomFichier          String
  empreinte           String // SHA-256 de l'original, reprise sur la page des signatures
  papier              Boolean         @default(false)
  creeLe              DateTime        @default(now())
  envoyeLe            DateTime? // transmis à la présidence pour signature
  presidenceNom       String?
  presidenceQualite   String?
  presidenceEmail     String?
  presidenceParaphe   Bytes?
  presidenceSignature Bytes?
  presidenceSigneLe   DateTime?
  profParaphe         Bytes?
  profSignature       Bytes?
  profSigneLe         DateTime?
  driveFileId         String?
  driveUrl            String?
  copieEnvoyeeLe      DateTime?

  @@index([profId, anneeDebut])
  @@index([anneeDebut])
}

// Lien de signature envoyé par mail à la présidence (sans compte dans l'appli). Le jeton est
// haché ; il ne vaut que pour l'adresse de la présidence en cours : changer la présidence
// dans les paramètres invalide les anciens liens.
model LienPresidence {
  id     String   @id @default(cuid())
  jeton  String   @unique
  email  String
  expire DateTime
  creeLe DateTime @default(now())
}

// --- Boîte à idées ---

enum TypeIdee {
  ECOLE // idée pour l'école
  APPLI // amélioration de l'appli
}

enum StatutIdee {
  NOUVELLE
  A_L_ETUDE
  RETENUE
  REALISEE
  NON_RETENUE
}

// Idée ou demande d'amélioration envoyée par un prof. Anonyme : aucun auteur n'est gardé.
model Idee {
  id        String     @id @default(cuid())
  type      TypeIdee
  titre     String
  texte     String
  auteurId  String?
  auteur    User?      @relation("IdeesAuteur", fields: [auteurId], references: [id], onDelete: SetNull)
  creeLe    DateTime   @default(now())
  statut    StatutIdee @default(NOUVELLE)
  reponse   String?
  reponduLe DateTime?
  majLe     DateTime   @updatedAt

  @@index([statut])
  @@index([auteurId])
}

// --- Plans de scène ---

enum CategorieElementScene {
  MUSICIEN // un musicien avec son instrument (place assise ou debout comprise)
  MOBILIER // chaise, pupitre, tabouret, table…
  MATERIEL // piano, percussions, amplis, micros, retours, praticables…
  DECOR // éléments fixes d'une scène : pilier, escalier, zone inutilisable…
}

enum FormeElementScene {
  RECT
  ROND
}

// Catalogue des éléments qu'on pose sur une scène, avec leur encombrement au sol (en cm,
// largeur × profondeur, l'avant étant tourné vers le public). Un musicien compte sa chaise
// et son pupitre (pour la liste du matériel à installer).
model ElementScene {
  id           String                @id @default(cuid())
  nom          String                @unique
  categorie    CategorieElementScene
  largeurCm    Int
  profondeurCm Int
  forme        FormeElementScene     @default(RECT)
  couleur      String                @default("#64748b")
  abrege       String? // affiché dans la forme : « Vlc », « Cl »…
  chaise       Boolean               @default(false)
  pupitre      Boolean               @default(false)
  motsCles     String? // instruments de l'annuaire reconnus : « violoncelle, cello »
  ordre        Int                   @default(0)
  actif        Boolean               @default(true)
}

// Une scène (ou salle) où l'on joue : ses dimensions et ses éléments fixes (JSON, même
// format que les éléments d'un plan).
model SceneConcert {
  id           String            @id @default(cuid())
  nom          String            @unique
  lieuId       String?
  lieu         LieuPresence?     @relation(fields: [lieuId], references: [id], onDelete: SetNull)
  largeurCm    Int
  profondeurCm Int
  elements     Json              @default("[]")
  notes        String?
  actif        Boolean           @default(true)
  majLe        DateTime          @updatedAt
  evenements   EvenementSaison[]
  plans        PlanScene[]
}

// Un plan de scène : un passage d'un concert, ou une formation type d'un ensemble (modèle).
// Dimensions et éléments copiés de la scène à la création, puis libres.
model PlanScene {
  id            String                    @id @default(cuid())
  titre         String
  sceneId       String?
  scene         SceneConcert?             @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  largeurCm     Int
  profondeurCm  Int
  elements      Json                      @default("[]")
  notes         String?
  evenementId   String?
  evenement     EvenementSaison?          @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  inscriptionId String?
  inscription   InscriptionHeureMusicale? @relation(fields: [inscriptionId], references: [id], onDelete: SetNull)
  ordre         Int                       @default(0)
  classeId      String? // ensemble concerné
  classe        Classe?                   @relation(fields: [classeId], references: [id], onDelete: SetNull)
  modele        Boolean                   @default(false) // formation type, réutilisable
  auteurId      String?
  auteur        User?                     @relation("PlansSceneAuteur", fields: [auteurId], references: [id], onDelete: SetNull)
  creeLe        DateTime                  @default(now())
  majLe         DateTime                  @updatedAt

  @@index([evenementId, ordre])
  @@index([inscriptionId])
  @@index([classeId])
}

// --- Demandes de matériel ---

enum UrgenceMateriel {
  BASSE
  NORMALE
  HAUTE
  URGENTE
}

enum StatutDemandeMateriel {
  NOUVELLE
  A_L_ETUDE
  VALIDEE
  COMMANDEE
  RECUE
  REFUSEE
}

// Matériel demandé par un prof, avec son niveau d'urgence ; la direction suit la demande
// jusqu'à la réception. Gardée si le compte du prof disparaît.
model DemandeMateriel {
  id           String                @id @default(cuid())
  auteurId     String?
  auteur       User?                 @relation("DemandesMateriel", fields: [auteurId], references: [id], onDelete: SetNull)
  titre        String
  quantite     Int                   @default(1)
  details      String?
  urgence      UrgenceMateriel       @default(NORMALE)
  statut       StatutDemandeMateriel @default(NOUVELLE)
  reponse      String?
  reponduLe    DateTime?
  creeLe       DateTime              @default(now())
  majLe        DateTime              @updatedAt
  propositions PropositionMateriel[]

  @@index([statut, urgence])
  @@index([auteurId])
}

// Une proposition d'achat pour une demande : lien vers le site, prix unitaire, précision.
// La direction peut en retenir une.
model PropositionMateriel {
  id           String          @id @default(cuid())
  demandeId    String
  demande      DemandeMateriel @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  libelle      String?
  url          String?
  prixCentimes Int?
  retenue      Boolean         @default(false)
  auteurId     String?
  auteur       User?           @relation("PropositionsMateriel", fields: [auteurId], references: [id], onDelete: SetNull)
  creeLe       DateTime        @default(now())

  @@index([demandeId])
}

// Le tableau Google Sheets des demandes de matériel, tenu à jour par l'appli (ligne unique).
model TableauMateriel {
  id        String    @id @default("singleton")
  fichierId String?
  url       String?
  majLe     DateTime?
  echecLe   DateTime? // dernière mise à jour ratée, tant qu'elle n'est pas rattrapée
}

// Dates des bulletins CHAM d'une année scolaire, réglées par la direction (sans ligne : les
// dates habituelles). L'historique des envois reste dans RappelBulletinCham.
model CalendrierBulletinCham {
  id         String   @id @default(cuid())
  anneeDebut Int
  trimestre  Int
  ouverture  DateTime @db.Date
  relance    DateTime @db.Date
  majLe      DateTime @updatedAt

  @@unique([anneeDebut, trimestre])
}

// --- Santé au travail ---

enum CategorieSuiviSante {
  SIG // suivi individuel général
  SIA // suivi adapté (handicap, travail de nuit, moins de 18 ans…)
  SIR // suivi renforcé (postes à risques)
}

enum TypeVisiteMedicale {
  EMBAUCHE
  PERIODIQUE
  INTERMEDIAIRE
  REPRISE
  PRE_REPRISE
  MI_CARRIERE
  DEMANDE
}

enum StatutVisiteMedicale {
  DEMANDEE // demandée au service, date pas encore fixée
  PREVUE // convocation reçue
  REALISEE
  ANNULEE
}

enum AvisVisiteMedicale {
  ATTESTATION // attestation de suivi (visite d'information et de prévention)
  APTE
  APTE_AMENAGEMENT
  INAPTE
}

// Un salarié suivi par le service de santé au travail : un prof de l'appli, ou une autre
// personne salariée sans compte. Aucune information médicale : seulement les dates.
model SalarieSante {
  id             String              @id @default(cuid())
  userId         String?             @unique
  user           User?               @relation("SuiviSante", fields: [userId], references: [id], onDelete: SetNull)
  nom            String
  prenom         String
  poste          String?
  categorie      CategorieSuiviSante @default(SIG)
  embaucheLe     DateTime?           @db.Date
  sortieLe       DateTime?           @db.Date
  affilieLe      DateTime?           @db.Date // déclaré au service de santé au travail
  desaffilieLe   DateTime?           @db.Date // départ signalé au service
  anneeNaissance Int? // pour la visite de mi-carrière (année des 45 ans)
  notes          String?
  creeLe         DateTime            @default(now())
  visites        VisiteMedicale[]
}

// Une visite : demandée, convoquée, réalisée ou annulée. L'attestation remise à l'employeur
// peut être jointe (PDF ou photos).
model VisiteMedicale {
  id               String               @id @default(cuid())
  salarieId        String
  salarie          SalarieSante         @relation(fields: [salarieId], references: [id], onDelete: Cascade)
  type             TypeVisiteMedicale
  statut           StatutVisiteMedicale
  date             DateTime?            @db.Date
  heure            String?
  lieu             String?
  avis             AvisVisiteMedicale?
  prochaineAvant   DateTime?            @db.Date // « prochaine visite au plus tard le »
  commentaire      String?
  pdf              Bytes?
  nomFichier       String?
  salariePrevenuLe DateTime?
  creeLe           DateTime             @default(now())
  majLe            DateTime             @updatedAt

  @@index([salarieId])
}

// Le service de santé au travail auquel l'école adhère. Ligne unique.
model OrganismeSante {
  id             String   @id @default("singleton")
  nom            String
  numeroAdherent String?
  adresse        String?
  telephone      String?
  email          String?
  siteWeb        String?
  majLe          DateTime @updatedAt
}

// Facture du service de santé au travail (cotisation annuelle, visites…). Le PDF est gardé
// dans l'appli et, quand le Drive est connecté, archivé aussi avec les factures d'achat.
model FactureSante {
  id              String    @id @default(cuid())
  date            DateTime  @db.Date
  numero          String?
  objet           String
  anneeCotisation Int
  montantCentimes Int?
  nombreSalaries  Int?
  echeance        DateTime? @db.Date
  payeeLe         DateTime? @db.Date
  pdf             Bytes
  nomFichier      String
  factureId       String?   @unique
  facture         Facture?  @relation(fields: [factureId], references: [id], onDelete: SetNull)
  creeLe          DateTime  @default(now())

  @@index([anneeCotisation])
}
