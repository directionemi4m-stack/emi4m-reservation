// Prisma schema — EMI4M Réservation de salles
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PROF
  ADMIN
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

enum StatutCreneau {
  EN_ATTENTE
  VALIDEE
  REFUSEE
  ANNULEE
}

enum TypeCours {
  INSTRUMENT
  FM
}

enum StatutPresence {
  PRESENT
  ABSENT
  EXCUSE
}

enum TypeAbsenceProf {
  RATTRAPAGE
  ARRET_MALADIE
}

enum TypeMission {
  COURS
  CONCERT
  REUNION
  AUTRE
}

enum TypeDocument {
  PERMIS_CONDUIRE
  CARTE_IDENTITE
}

// Compte prof/admin. Provisionné par la direction (pas d'auto-inscription).
// Connexion par email + mot de passe (défini via un lien envoyé par email).
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  motDePasseHash  String?
  nom             String
  prenom          String
  role            Role      @default(PROF)
  actif           Boolean   @default(true)
  creeLe          DateTime  @default(now())

  tokensMotDePasse TokenMotDePasse[]

  creneauxRecurrents CreneauRecurrent[]
  demandes           Demande[]          @relation("DemandeAuteur")
  creneauxTraites    DemandeCreneau[]   @relation("CreneauTraitePar")

  classes      Classe[]      @relation("ClasseProf")
  pointages    Pointage[]    @relation("PointageProf")
  absencesProf AbsenceProf[] @relation("AbsenceProf")
  trajets      Trajet[]      @relation("TrajetProf")
  identite     IdentiteProf?
  documents    DocumentProf[]
}

// Lien à usage unique envoyé par email pour définir ou réinitialiser le mot de
// passe. Le token stocké est haché (sha256) ; le brut ne vit que dans l'email.
model TokenMotDePasse {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token  String   @unique
  expire DateTime
  creeLe DateTime @default(now())
}

model Commune {
  id       String    @id @default(cuid())
  nom      String    @unique
  slug     String    @unique
  salles   Salle[]
  contacts Contact[]
}

// Contact (mairie, gestionnaire de salle...) à qui adresser une demande de
// réservation par email — proposé par défaut pour les salles de sa commune.
model Contact {
  id        String  @id @default(cuid())
  nom       String
  email     String
  communeId String
  commune   Commune @relation(fields: [communeId], references: [id], onDelete: Cascade)
  actif     Boolean @default(true)
}

model Salle {
  id        String  @id @default(cuid())
  nom       String
  communeId String
  commune   Commune @relation(fields: [communeId], references: [id])
  actif     Boolean @default(true)

  creneauxRecurrents CreneauRecurrent[]
  demandes           Demande[]
  demandeCreneaux    DemandeCreneau[]

  @@unique([communeId, nom])
}

// Emploi du temps de base, récurrent hebdomadaire
model CreneauRecurrent {
  id          String      @id @default(cuid())
  profId      String
  prof        User        @relation(fields: [profId], references: [id])
  salleId     String
  salle       Salle       @relation(fields: [salleId], references: [id])
  jourSemaine JourSemaine
  heureDebut  DateTime    @db.Time
  heureFin    DateTime    @db.Time
  dateDebut   DateTime    @db.Date
  dateFin     DateTime?   @db.Date
  actif       Boolean     @default(true)
  creeLe      DateTime    @default(now())

  @@index([salleId, jourSemaine])
}

// "Panier" de dates soumises ensemble par un prof, pour une même salle.
model Demande {
  id      String   @id @default(cuid())
  profId  String
  prof    User     @relation("DemandeAuteur", fields: [profId], references: [id])
  salleId String
  salle   Salle    @relation(fields: [salleId], references: [id])
  creeLe  DateTime @default(now())

  creneaux DemandeCreneau[]

  @@index([profId])
}

// Une ligne = une date + un horaire précis. Le statut vit ici (pas sur Demande)
// car un même lot peut mélanger dates rejetées automatiquement et dates en attente.
model DemandeCreneau {
  id         String   @id @default(cuid())
  demandeId  String
  demande    Demande  @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  salleId    String
  salle      Salle    @relation(fields: [salleId], references: [id])
  date       DateTime @db.Date
  heureDebut DateTime @db.Time
  heureFin   DateTime @db.Time

  statut           StatutCreneau @default(EN_ATTENTE)
  rejetAutomatique Boolean       @default(false)
  creneauBloquant  String?
  motifRefus       String?
  traiteeLe        DateTime?
  traiteeParId     String?
  traiteePar       User?         @relation("CreneauTraitePar", fields: [traiteeParId], references: [id])

  @@index([salleId, date])
}

// --- Présences ---

model LieuPresence {
  id      String   @id @default(cuid())
  nom     String   @unique
  actif   Boolean  @default(true)
  classes Classe[]
}

model NiveauFM {
  id      String   @id @default(cuid())
  nom     String   @unique
  actif   Boolean  @default(true)
  classes Classe[]
}

// Liste fermée des matières enseignées, proposée au choix à la création d'un cours
// (remplace la saisie libre du nom). Le type détermine si niveau/lieu FM s'affichent.
model Discipline {
  id    String    @id @default(cuid())
  nom   String    @unique
  type  TypeCours @default(INSTRUMENT)
  actif Boolean   @default(true)
}

model Classe {
  id         String        @id @default(cuid())
  profId     String
  prof       User          @relation("ClasseProf", fields: [profId], references: [id])
  type       TypeCours
  nom        String
  emoji      String
  jour       String?
  lieuId     String?
  lieu       LieuPresence? @relation(fields: [lieuId], references: [id])
  niveauFMId String?
  niveauFM   NiveauFM?     @relation(fields: [niveauFMId], references: [id])
  dateDebut  DateTime      @db.Date
  actif      Boolean       @default(true)
  creeLe     DateTime      @default(now())

  eleves       Eleve[]
  seances      Seance[]
  pointages    Pointage[]
  absencesProf AbsenceProf[]

  @@index([profId])
}

model Eleve {
  id       String  @id @default(cuid())
  classeId String
  classe   Classe  @relation(fields: [classeId], references: [id], onDelete: Cascade)
  nom      String
  actif    Boolean @default(true)

  marques PresenceMarque[]
}

model Seance {
  id       String   @id @default(cuid())
  classeId String
  classe   Classe   @relation(fields: [classeId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date

  pointage    Pointage?
  absenceProf AbsenceProf?

  @@index([classeId, date])
}

// Une séance où le prof (pas un élève) était absent — rattrapage à prévoir,
// ou arrêt maladie à suivre. Exclusif avec Pointage pour la même séance.
model AbsenceProf {
  id             String          @id @default(cuid())
  seanceId       String          @unique
  seance         Seance          @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  classeId       String
  classe         Classe          @relation(fields: [classeId], references: [id], onDelete: Cascade)
  profId         String
  prof           User            @relation("AbsenceProf", fields: [profId], references: [id])
  type           TypeAbsenceProf
  dateRattrapage DateTime?       @db.Date
  commentaire    String?
  creeLe         DateTime        @default(now())

  @@index([classeId])
}

// Une feuille de présence pour une séance donnée (au plus une par séance).
model Pointage {
  id       String   @id @default(cuid())
  seanceId String   @unique
  seance   Seance   @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  classeId String
  classe   Classe   @relation(fields: [classeId], references: [id], onDelete: Cascade)
  profId   String
  prof     User     @relation("PointageProf", fields: [profId], references: [id])
  creeLe   DateTime @default(now())
  majLe    DateTime @updatedAt

  marques PresenceMarque[]

  @@index([classeId])
}

model PresenceMarque {
  id         String         @id @default(cuid())
  pointageId String
  pointage   Pointage       @relation(fields: [pointageId], references: [id], onDelete: Cascade)
  eleveId    String
  eleve      Eleve          @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  statut     StatutPresence @default(PRESENT)

  @@unique([pointageId, eleveId])
}

// --- Frais de déplacement ---

// Trajet type de référence (ex. « Villard/Autrans »), géré par l'admin — km et
// prix fixes, saisis une fois (barème kilométrique), pas recalculés à la volée.
model TypeTrajet {
  id      String   @id @default(cuid())
  nom     String   @unique
  km      Float
  prix    Float
  actif   Boolean  @default(true)
  trajets Trajet[]
}

// Un trajet loggé par un prof. km/prix/nom sont une copie de TypeTrajet au
// moment de la saisie : un trajet déjà enregistré ne doit pas bouger si le
// barème change plus tard.
model Trajet {
  id                String      @id @default(cuid())
  profId            String
  prof              User        @relation("TrajetProf", fields: [profId], references: [id])
  date              DateTime    @db.Date
  typeMission       TypeMission
  precisionMission  String?
  typeTrajetId      String
  typeTrajet        TypeTrajet  @relation(fields: [typeTrajetId], references: [id])
  trajetNom         String
  km                Float
  prix              Float
  creeLe            DateTime    @default(now())

  @@index([profId, date])
}

// Fiche identité/véhicule d'un prof, saisie une fois — sert de justificatif
// pour les remboursements de frais kilométriques (permis, assurance, véhicule).
model IdentiteProf {
  id                      String   @id @default(cuid())
  profId                  String   @unique
  prof                    User     @relation(fields: [profId], references: [id], onDelete: Cascade)
  adresseDomicile         String?
  numeroPermis            String?
  numeroCarteGrise        String?
  numeroAssuranceAuto     String?
  immatriculationVehicule String?
  marqueModeleVehicule    String?
  puissanceFiscale        String?
  majLe                   DateTime @updatedAt
}

// Copie d'une pièce justificative (permis, carte d'identité) — le fichier lui-même
// vit uniquement dans Google Drive (dossier personnel du prof) ; ici on ne garde
// que la référence. Un envoi remplace le précédent (un seul document par type et par prof).
model DocumentProf {
  id          String       @id @default(cuid())
  profId      String
  prof        User         @relation(fields: [profId], references: [id], onDelete: Cascade)
  type        TypeDocument
  nomFichier  String
  driveFileId String
  driveUrl    String
  creeLe      DateTime     @default(now())
  majLe       DateTime     @updatedAt

  @@unique([profId, type])
}

// Jeton OAuth d'un vrai compte Google (pas le compte de service — celui-ci n'a pas
// de quota de stockage Drive et ne peut donc pas y déposer de fichiers). Ligne unique.
model ConfigGoogle {
  id           String   @id @default("singleton")
  refreshToken String
  compteEmail  String?
  majLe        DateTime @updatedAt
}

